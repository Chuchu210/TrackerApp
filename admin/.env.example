# Copy to admin/.env.local for local development
#   cp .env.example .env.local

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# NextAuth session secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-openssl-rand-base64-32"

# Comma-separated allowlist of Google emails permitted to sign in
ALLOWED_ADMIN_EMAILS="you@example.com"

# Backend tracker API (server-to-server; not exposed to the browser)
TRACKER_API_URL="http://127.0.0.1:3001"
# Must match ADMIN_API_KEY in backend/.env
TRACKER_API_KEY="dev-api-key-change-me"
