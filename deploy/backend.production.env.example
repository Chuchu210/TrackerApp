# Copy to backend/.env on the server

DATABASE_URL="postgresql://tracker:STRONG_PASSWORD@localhost:5432/tracker"
PORT=3001

TRACKER_BASE_URL="https://track.arthome.ai"
TRACKER_SERVER_IP="YOUR_VPS_IP"
TRACKER_DNS_MODE="cname_root"
TRACKER_DOMAIN_PROTOCOL="https"

ADMIN_API_KEY="generate-a-long-random-key"
# Porte d'entrée des leads externes : UNE clé par site partenaire, « site:clé,site:clé ». Jamais ADMIN_API_KEY.
INTAKE_API_KEYS=""
# Liste de suppression (HMAC des contacts effacés). OBLIGATOIRE pour la porte d'entrée, 32 caractères au moins
# (`openssl rand -hex 32`). NE JAMAIS LA CHANGER : une empreinte témoin la vérifie, et une clé changée fait
# refuser toute entrée en 503 plutôt que de laisser revenir les personnes effacées. À sauvegarder.
ERASURE_HMAC_KEY=""
CORS_ORIGIN="*"
ALLOW_TEST_IP_OVERRIDE=false

# Google Apps Script web app URL for nexoquote callback-form leads.

# Rétention des données personnelles des leads, en jours : au-delà, nom, téléphone, e-mail, IP, agent et URL sont
# effacés automatiquement des leads ET des visites (conversions, clics, journaux de postback). SANS CETTE VARIABLE,
# LA RÉTENTION NE TOURNE PAS et le journal le répète chaque nuit.
LEADS_PII_RETENTION_DAYS=365
