DATABASE_URL="postgresql://tracker:tracker@localhost:5433/tracker"
PORT=3001
TRACKER_BASE_URL="http://localhost:3001"
# Custom domains DNS mode:
# cname_root (default) — CNAME track → your root domain (when root A already points to server)
# a — separate A record on track subdomain
TRACKER_DNS_MODE="cname_root"
# Optional comma-separated DNS resolvers for domain verification (defaults to Google + Cloudflare)
TRACKER_DNS_SERVERS="8.8.8.8,1.1.1.1"
TRACKER_CNAME_TARGET=""
TRACKER_SERVER_IP="76.13.114.85"
TRACKER_DOMAIN_PROTOCOL="https"
ADMIN_API_KEY="dev-api-key-change-me"
# Mediago S2S postback — account name from Mediago dashboard (required for conversion test to show ✓)
MEDIAGO_ACCOUNT_NAME=""
# Incoming-postback security: comma/space separated IPs or CIDRs allowed to fire
# S2S postbacks without a per-campaign secret. Leave empty to rely only on secrets.
# When BOTH this is empty AND a campaign has no postbackSecret, that campaign's
# postbacks stay open (backward compatible).
POSTBACK_IP_ALLOWLIST=""
# Use * to allow LP script calls from any landing page domain
CORS_ORIGIN="*"
# Local dev only: allow ?__test_ip=109.52.221.77 on click URLs to simulate real geo/IP
ALLOW_TEST_IP_OVERRIDE=true
# Lander file storage (uploaded HTML/CSS/JS)
LANDERS_STORAGE_ROOT="./storage/landers"
LANDERS_MAX_UPLOAD_MB=50

# Alert notifications (rules/decision engine) — all optional, best-effort delivery.
# Only alerts at/above NOTIFY_MIN_SEVERITY are sent (info|warning|danger).
NOTIFY_MIN_SEVERITY="warning"
# Telegram: create a bot via @BotFather, then get the chat id you want to notify.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Generic JSON webhook (Slack incoming webhook, Zapier/Make, or an email relay).
NOTIFY_WEBHOOK_URL=""

# Anti-fraud click-flood detection: if one IP produces >= MAX clicks within
# WINDOW seconds, the click's bot score is raised. Set MAX to 0 to disable.
FRAUD_VELOCITY_WINDOW_SECONDS=60
FRAUD_VELOCITY_MAX_CLICKS=20

# Auto-winner for path A/B variant rotation (runs hourly). Deactivates losing
# variants once one clearly wins. Set AUTO_WINNER_ENABLED=false to disable.
AUTO_WINNER_ENABLED=true
AUTO_WINNER_WINDOW_DAYS=7
AUTO_WINNER_MIN_VISITS_PER_VARIANT=200
AUTO_WINNER_MIN_TOTAL_VISITS=500
AUTO_WINNER_MIN_MARGIN_PCT=20

# Reporting currency + FX. Conversions store revenue/cost normalized to
# BASE_CURRENCY using these rates (units of base per 1 unit of the currency).
BASE_CURRENCY="USD"
FX_RATES="EUR:1.08,GBP:1.27"
# Default report timezone (IANA name). Reports also accept ?tz=Europe/Paris.
REPORT_TIMEZONE="UTC"

# Auto-cost: query keys to read the paid per-click cost from (native cost macro).
# Defaults cover cost/bid/cpc/bid_price/price/click_cost. Comma separated.
CLICK_COST_KEYS="cost,bid,cpc,bid_price,price,click_cost"

# Scheduled daily conversions export (runs 02:30). Disabled until EXPORT_ENABLED=true.
EXPORT_ENABLED=false
EXPORT_WINDOW_DAYS=1
# Directory to write the CSV to (created if missing).
EXPORT_DIR=""
# Optional endpoint to POST the CSV to (S3/BigQuery ingestion, data lake, etc.).
EXPORT_WEBHOOK_URL=""
